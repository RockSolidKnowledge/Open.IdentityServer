<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Open.IdentityServer.Templates</PackageId>
        <Description>Project templates for Open.IdentityServer</Description>
        <PackageProjectUrl>https://github.com/RockSolidKnowledge/Open.IdentityServer</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReleaseNotes>https://github.com/RockSolidKnowledge/Open.IdentityServer/releases</PackageReleaseNotes>
        <PackageIcon>OpenIdentityServerIcon.png</PackageIcon>
        <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;Security;Identity;IdentityServer;ASP.NET Identity;dotnet-new;templates;open-identityserver;</PackageTags>
        <PackageType>Template</PackageType>

        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <None Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;
                                                 templates/**/.git/**;templates/**/.vs/**;
                                                 templates/**/*.db;templates/**/*.sqlite*;
                                                 templates/**/*.pfx;templates/**/*.p12;
                                                 templates/**/*.pem;templates/**/*.key;
                                                 templates/**/.env*;templates/**/secrets.json"
              Pack="true"
              PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../../OpenIdentityServerIcon.png" Pack="true" Visible="false" PackagePath=""/>
    </ItemGroup>

</Project>
